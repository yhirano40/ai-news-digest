<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>過去の記事一覧 - AIニュース ダイジェスト</title>
<link rel="stylesheet" href="../style.css">
</head>
<body>
<header>
  <h1>過去の記事一覧</h1>
  <nav><a href="../index.html">最新へ戻る</a></nav>
</header>
<main>
  <ul class="archive-list">
    {% for day in days %}
    <li><a href="{{ day.date }}.html">{{ day.date }}</a>（{{ day.articles|length }}件）</li>
    {% endfor %}
  </ul>
</main>
<footer>
  <p>生成: {{ generated_at }}</p>
</footer>
</body>
</html>
